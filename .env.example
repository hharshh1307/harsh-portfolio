# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Site ---
SITE_URL=https://your-domain.vercel.app

# --- Chat agent (required for /ask) ---
OPENAI_API_KEY=
# CHAT_MODEL=gpt-4.1-mini        # optional override
# TAVILY_API_KEY=                # optional: lets the agent search current events

# --- Spotify "now playing" (optional) ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=          # get one with: node scripts/spotify-auth.mjs

# --- Telegram content bot ---
TELEGRAM_BOT_TOKEN=              # from @BotFather
TELEGRAM_WEBHOOK_SECRET=         # any long random string: openssl rand -hex 32
TELEGRAM_OWNER_ID=               # your numeric Telegram id: message the bot /whoami
# BOT_MODEL=gpt-4.1              # optional override

# GitHub fine-grained token: this repo only, "Contents: read and write" + "Deployments: read"
GITHUB_TOKEN=
GITHUB_REPO=hharshh1307/harsh-portfolio
# GITHUB_BRANCH=main

# Optional: Vercel → Settings → Git → Deploy Hooks, enables /deploy
# VERCEL_DEPLOY_HOOK_URL=

# --- Valorant live stats (optional) via HenrikDev community API ---
# Free key: https://api.henrikdev.xyz/dashboard → API Keys → Generate. Riot's official API has no personal keys for Valorant.
# HENRIK_API_KEY=
# VALORANT_RIOT_ID=name#tag
# VALORANT_REGION=ap
